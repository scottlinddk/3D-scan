  "components": {
    "schemas": {
      "Artifact": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "job_id": {
            "type": "string",
            "title": "Job Id"
          },
          "kind": {
            "type": "string",
            "title": "Kind"
          },
          "filename": {
            "type": "string",
            "title": "Filename"
          },
          "size": {
            "type": "integer",
            "title": "Size"
          },
          "sha256": {
            "type": "string",
            "title": "Sha256"
          },
          "protected": {
            "type": "boolean",
            "title": "Protected"
          }
        },
        "type": "object",
        "required": ["id", "job_id", "kind", "filename", "size", "sha256", "protected"],
        "title": "Artifact"
      },
      "Claim": {
        "properties": {
          "capabilities": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 20,
            "minItems": 1,
            "title": "Capabilities"
          },
          "lease_seconds": {
            "type": "integer",
            "maximum": 900.0,
            "minimum": 5.0,
            "title": "Lease Seconds",
            "default": 60
          }
        },
        "type": "object",
        "required": ["capabilities"],
        "title": "Claim"
      },
      "ClaimResult": {
        "properties": {
          "task": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ClaimedTask"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "title": "ClaimResult"
      },
      "ClaimedTask": {
